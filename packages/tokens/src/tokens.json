{
  "$schema": "./tokens.schema.json",
  "$description": "Notsho design tokens. W3C DTCG format with one extension: a token's $value may be an object keyed by mode ({ light, dark }). Three tiers flow downward only: primitive -> semantic -> component. References use {dot.path} and are compiled to var() so runtime overrides cascade.",
  "$prefix": "notsho",

  "primitive": {
    "color": {
      "$type": "color",
      "$description": "Raw OKLCH ramps. Users never touch these directly; the customizer derives them.",
      "white": { "$value": "oklch(1 0 0)" },
      "black": { "$value": "oklch(0 0 0)" },
      "gray": {
        "50":  { "$value": "oklch(0.985 0.003 250)" },
        "100": { "$value": "oklch(0.965 0.004 250)" },
        "200": { "$value": "oklch(0.925 0.006 250)" },
        "300": { "$value": "oklch(0.865 0.008 250)" },
        "400": { "$value": "oklch(0.72 0.012 250)" },
        "500": { "$value": "oklch(0.58 0.014 250)" },
        "600": { "$value": "oklch(0.48 0.014 250)" },
        "700": { "$value": "oklch(0.38 0.012 250)" },
        "800": { "$value": "oklch(0.27 0.010 250)" },
        "900": { "$value": "oklch(0.20 0.008 250)" },
        "950": { "$value": "oklch(0.14 0.006 250)" }
      },
      "blue": {
        "50":  { "$value": "oklch(0.97 0.014 255)" },
        "100": { "$value": "oklch(0.94 0.030 255)" },
        "200": { "$value": "oklch(0.88 0.060 255)" },
        "300": { "$value": "oklch(0.80 0.100 255)" },
        "400": { "$value": "oklch(0.70 0.160 255)" },
        "500": { "$value": "oklch(0.60 0.200 255)" },
        "600": { "$value": "oklch(0.53 0.210 255)" },
        "700": { "$value": "oklch(0.46 0.190 255)" },
        "800": { "$value": "oklch(0.39 0.150 255)" },
        "900": { "$value": "oklch(0.32 0.110 255)" },
        "950": { "$value": "oklch(0.25 0.080 255)" }
      },
      "red": {
        "50":  { "$value": "oklch(0.97 0.014 25)" },
        "100": { "$value": "oklch(0.94 0.030 25)" },
        "200": { "$value": "oklch(0.88 0.060 25)" },
        "300": { "$value": "oklch(0.80 0.110 25)" },
        "400": { "$value": "oklch(0.70 0.170 25)" },
        "500": { "$value": "oklch(0.60 0.210 25)" },
        "600": { "$value": "oklch(0.53 0.210 25)" },
        "700": { "$value": "oklch(0.46 0.180 25)" },
        "800": { "$value": "oklch(0.39 0.140 25)" },
        "900": { "$value": "oklch(0.32 0.100 25)" },
        "950": { "$value": "oklch(0.25 0.070 25)" }
      },
      "green": {
        "50":  { "$value": "oklch(0.97 0.018 150)" },
        "100": { "$value": "oklch(0.94 0.040 150)" },
        "200": { "$value": "oklch(0.88 0.080 150)" },
        "300": { "$value": "oklch(0.80 0.130 150)" },
        "400": { "$value": "oklch(0.72 0.170 150)" },
        "500": { "$value": "oklch(0.64 0.180 150)" },
        "600": { "$value": "oklch(0.55 0.160 150)" },
        "700": { "$value": "oklch(0.47 0.130 150)" },
        "800": { "$value": "oklch(0.39 0.100 150)" },
        "900": { "$value": "oklch(0.32 0.075 150)" },
        "950": { "$value": "oklch(0.25 0.050 150)" }
      },
      "amber": {
        "50":  { "$value": "oklch(0.98 0.020 80)" },
        "100": { "$value": "oklch(0.95 0.050 80)" },
        "200": { "$value": "oklch(0.90 0.100 80)" },
        "300": { "$value": "oklch(0.85 0.140 80)" },
        "400": { "$value": "oklch(0.80 0.160 80)" },
        "500": { "$value": "oklch(0.74 0.160 75)" },
        "600": { "$value": "oklch(0.64 0.150 70)" },
        "700": { "$value": "oklch(0.54 0.130 65)" },
        "800": { "$value": "oklch(0.45 0.105 60)" },
        "900": { "$value": "oklch(0.37 0.080 55)" },
        "950": { "$value": "oklch(0.28 0.055 50)" }
      }
    },

    "font": {
      "$type": "fontFamily",
      "system-sans": { "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "system-serif": { "$value": "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif" },
      "system-mono": { "$value": "ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace" }
    },

    "size": {
      "$type": "dimension",
      "$description": "Type scale. 1.2 ratio from a 1rem base.",
      "xs":   { "$value": "0.75rem" },
      "sm":   { "$value": "0.875rem" },
      "md":   { "$value": "1rem" },
      "lg":   { "$value": "1.125rem" },
      "xl":   { "$value": "1.25rem" },
      "2xl":  { "$value": "1.5rem" },
      "3xl":  { "$value": "1.875rem" },
      "4xl":  { "$value": "2.25rem" },
      "5xl":  { "$value": "3rem" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },

    "leading": {
      "$type": "number",
      "tight":  { "$value": "1.2" },
      "snug":   { "$value": "1.35" },
      "normal": { "$value": "1.5" },
      "loose":  { "$value": "1.7" }
    },

    "tracking": {
      "$type": "dimension",
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.04em" }
    },

    "space": {
      "$type": "dimension",
      "$description": "4px grid.",
      "0":  { "$value": "0px" },
      "px": { "$value": "1px" },
      "0-5": { "$value": "0.125rem" },
      "1":  { "$value": "0.25rem" },
      "1-5": { "$value": "0.375rem" },
      "2":  { "$value": "0.5rem" },
      "2-5": { "$value": "0.625rem" },
      "3":  { "$value": "0.75rem" },
      "4":  { "$value": "1rem" },
      "5":  { "$value": "1.25rem" },
      "6":  { "$value": "1.5rem" },
      "8":  { "$value": "2rem" },
      "10": { "$value": "2.5rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" }
    },

    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "xs":   { "$value": "0.125rem" },
      "sm":   { "$value": "0.25rem" },
      "md":   { "$value": "0.375rem" },
      "lg":   { "$value": "0.5rem" },
      "xl":   { "$value": "0.75rem" },
      "2xl":  { "$value": "1rem" },
      "full": { "$value": "9999px" }
    },

    "border": {
      "$type": "dimension",
      "thin":  { "$value": "1px" },
      "thick": { "$value": "2px" }
    },

    "shadow": {
      "$type": "shadow",
      "none": { "$value": "none" },
      "sm":   { "$value": "0 1px 2px oklch(0 0 0 / 0.06)" },
      "md":   { "$value": "0 2px 6px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.04)" },
      "lg":   { "$value": "0 8px 24px oklch(0 0 0 / 0.12), 0 2px 6px oklch(0 0 0 / 0.06)" },
      "xl":   { "$value": "0 20px 48px oklch(0 0 0 / 0.18), 0 4px 12px oklch(0 0 0 / 0.08)" }
    },

    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast":    { "$value": "120ms" },
      "normal":  { "$value": "200ms" },
      "slow":    { "$value": "320ms" }
    },

    "easing": {
      "$type": "cubicBezier",
      "linear":   { "$value": "linear" },
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter":    { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },

  "semantic": {
    "$description": "Intent-level tokens. This is the tier the customizer exposes and what components consume.",

    "color": {
      "$type": "color",

      "accent":        { "$value": { "light": "{color.blue.600}", "dark": "{color.blue.400}" }, "$description": "Primary brand/action color." },
      "accent-hover":  { "$value": { "light": "{color.blue.700}", "dark": "{color.blue.300}" } },
      "accent-active": { "$value": { "light": "{color.blue.800}", "dark": "{color.blue.200}" } },
      "accent-subtle": { "$value": { "light": "{color.blue.50}",  "dark": "{color.blue.950}" }, "$description": "Tinted background for selected/hover states." },
      "accent-border": { "$value": { "light": "{color.blue.200}", "dark": "{color.blue.800}" } },
      "on-accent":     { "$value": { "light": "{color.white}",    "dark": "{color.gray.950}" }, "$description": "Text/icon color placed on accent." },

      "surface":         { "$value": { "light": "{color.white}",    "dark": "{color.gray.950}" }, "$description": "Page background." },
      "surface-raised":  { "$value": { "light": "{color.white}",    "dark": "{color.gray.900}" }, "$description": "Cards, panels." },
      "surface-sunken":  { "$value": { "light": "{color.gray.50}",  "dark": "{color.gray.950}" }, "$description": "Wells, inset areas, code blocks." },
      "surface-overlay": { "$value": { "light": "{color.white}",    "dark": "{color.gray.800}" }, "$description": "Dialogs, menus, popovers." },
      "surface-hover":   { "$value": { "light": "{color.gray.100}", "dark": "{color.gray.800}" } },
      "surface-active":  { "$value": { "light": "{color.gray.200}", "dark": "{color.gray.700}" } },
      "scrim":           { "$value": { "light": "oklch(0 0 0 / 0.4)", "dark": "oklch(0 0 0 / 0.6)" }, "$description": "Backdrop behind dialogs." },

      "border":        { "$value": { "light": "{color.gray.200}", "dark": "{color.gray.800}" } },
      "border-strong": { "$value": { "light": "{color.gray.300}", "dark": "{color.gray.700}" }, "$description": "Inputs, dividers that must read clearly." },

      "text":         { "$value": { "light": "{color.gray.950}", "dark": "{color.gray.50}" }, "$description": "Body and headings." },
      "text-muted":   { "$value": { "light": "{color.gray.600}", "dark": "{color.gray.400}" }, "$description": "Secondary text." },
      "text-subtle":  { "$value": { "light": "{color.gray.500}", "dark": "{color.gray.500}" }, "$description": "Placeholders, hints." },
      "text-inverse": { "$value": { "light": "{color.white}",    "dark": "{color.gray.950}" } },

      "danger":        { "$value": { "light": "{color.red.600}", "dark": "{color.red.400}" } },
      "danger-hover":  { "$value": { "light": "{color.red.700}", "dark": "{color.red.300}" } },
      "danger-subtle": { "$value": { "light": "{color.red.50}",  "dark": "{color.red.950}" } },
      "on-danger":     { "$value": { "light": "{color.white}",   "dark": "{color.gray.950}" } },

      "success":        { "$value": { "light": "{color.green.600}", "dark": "{color.green.400}" } },
      "success-subtle": { "$value": { "light": "{color.green.50}",  "dark": "{color.green.950}" } },

      "warning":        { "$value": { "light": "{color.amber.600}", "dark": "{color.amber.400}" } },
      "warning-subtle": { "$value": { "light": "{color.amber.50}",  "dark": "{color.amber.950}" } },

      "focus-ring": { "$value": "{color.accent}", "$description": "Keyboard focus indicator." }
    },

    "font": {
      "$type": "fontFamily",
      "body":    { "$value": "{font.system-sans}", "$description": "Default UI and body text." },
      "heading": { "$value": "{font.body}", "$description": "Headings. Defaults to body; customizer can split them." },
      "code":    { "$value": "{font.system-mono}" }
    },

    "text": {
      "$description": "Semantic type roles.",
      "body-size":    { "$type": "dimension", "$value": "{size.md}" },
      "body-leading": { "$type": "number", "$value": "{leading.normal}" },
      "heading-weight":   { "$type": "fontWeight", "$value": "{weight.semibold}" },
      "heading-leading":  { "$type": "number", "$value": "{leading.tight}" },
      "heading-tracking": { "$type": "dimension", "$value": "{tracking.tight}" },
      "label-weight": { "$type": "fontWeight", "$value": "{weight.medium}", "$description": "Buttons, form labels, tabs." }
    },

    "radius": {
      "$type": "dimension",
      "control": { "$value": "{radius.md}", "$description": "Buttons, inputs, checkboxes." },
      "card":    { "$value": "{radius.lg}" },
      "overlay": { "$value": "{radius.xl}", "$description": "Dialogs, menus." },
      "pill":    { "$value": "{radius.full}" }
    },

    "border": {
      "$type": "dimension",
      "width": { "$value": "{border.thin}" },
      "focus-width": { "$value": "{border.thick}" }
    },

    "shadow": {
      "$type": "shadow",
      "raised":  { "$value": "{shadow.sm}", "$description": "Cards." },
      "floating": { "$value": "{shadow.lg}", "$description": "Menus, popovers." },
      "overlay": { "$value": "{shadow.xl}", "$description": "Dialogs." }
    },

    "space": {
      "$type": "dimension",
      "$description": "Density knobs. The customizer scales these together.",
      "control-x": { "$value": "{space.3}", "$description": "Horizontal padding inside controls." },
      "control-y": { "$value": "{space.2}", "$description": "Vertical padding inside controls." },
      "control-gap": { "$value": "{space.2}", "$description": "Gap between icon and label inside a control." },
      "inset":     { "$value": "{space.4}", "$description": "Padding inside cards and panels." },
      "inset-lg":  { "$value": "{space.6}", "$description": "Padding inside dialogs." },
      "stack":     { "$value": "{space.3}", "$description": "Gap between stacked siblings." },
      "section":   { "$value": "{space.8}", "$description": "Gap between sections." }
    },

    "size": {
      "$type": "dimension",
      "control":    { "$value": "2.25rem", "$description": "Default control height (36px)." },
      "control-sm": { "$value": "1.875rem" },
      "control-lg": { "$value": "2.75rem" },
      "icon":       { "$value": "1rem" }
    },

    "motion": {
      "duration-fast":   { "$type": "duration", "$value": "{duration.fast}", "$description": "Hover, press." },
      "duration-normal": { "$type": "duration", "$value": "{duration.normal}", "$description": "Reveal, expand." },
      "duration-slow":   { "$type": "duration", "$value": "{duration.slow}", "$description": "Dialogs, page-level." },
      "easing-standard": { "$type": "cubicBezier", "$value": "{easing.standard}" },
      "easing-enter":    { "$type": "cubicBezier", "$value": "{easing.enter}" },
      "easing-exit":     { "$type": "cubicBezier", "$value": "{easing.exit}" }
    }
  },

  "component": {
    "$description": "Component-scoped overrides. Default to semantic; the customizer's advanced panel and power users edit these.",

    "button": {
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "weight": { "$type": "fontWeight", "$value": "{text.label-weight}" },
      "height": { "$type": "dimension", "$value": "{size.control}" },
      "padding-x": { "$type": "dimension", "$value": "{space.control-x}" }
    },
    "input": {
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "height": { "$type": "dimension", "$value": "{size.control}" },
      "padding-x": { "$type": "dimension", "$value": "{space.control-x}" },
      "border": { "$type": "color", "$value": "{color.border-strong}" },
      "background": { "$type": "color", "$value": "{color.surface}" }
    },
    "card": {
      "radius": { "$type": "dimension", "$value": "{radius.card}" },
      "padding": { "$type": "dimension", "$value": "{space.inset}" },
      "background": { "$type": "color", "$value": "{color.surface-raised}" },
      "border": { "$type": "color", "$value": "{color.border}" },
      "shadow": { "$type": "shadow", "$value": "{shadow.raised}" }
    },
    "dialog": {
      "radius": { "$type": "dimension", "$value": "{radius.overlay}" },
      "padding": { "$type": "dimension", "$value": "{space.inset-lg}" },
      "background": { "$type": "color", "$value": "{color.surface-overlay}" },
      "shadow": { "$type": "shadow", "$value": "{shadow.overlay}" },
      "max-width": { "$type": "dimension", "$value": "32rem" }
    },
    "badge": {
      "radius": { "$type": "dimension", "$value": "{radius.pill}" },
      "weight": { "$type": "fontWeight", "$value": "{weight.medium}" }
    },
    "tooltip": {
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "background": { "$type": "color", "$value": { "light": "{color.gray.900}", "dark": "{color.gray.100}" } },
      "text": { "$type": "color", "$value": { "light": "{color.gray.50}", "dark": "{color.gray.950}" } }
    }
  }
}
